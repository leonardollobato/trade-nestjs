# Node Environment
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_TYPE=sqlite # Options: sqlite, mongodb
DATABASE_PATH=./data/trading.db
MONGODB_URI=mongodb://localhost:27017/trading

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug

# Tick Generator Settings
TICK_GENERATOR_ENABLED=true
DEFAULT_TICK_INTERVAL=15min